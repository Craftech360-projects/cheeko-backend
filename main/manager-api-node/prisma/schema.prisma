model word_bank {
  id               BigInt   @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  level            Int      @default(1)
  category         String?  @db.VarChar(100)
  language         String   @default("en") @db.VarChar(10)
  word             String
  item_type        String?  @db.VarChar(50)
  meaning_simple   String?
  example_sentence String?
  phonics_chunks   String?
  spell_difficulty Int?
  active           Boolean  @default(true)
  create_date      DateTime @default(now()) @db.Timestamptz(6)
  update_date      DateTime @default(now()) @db.Timestamptz(6)

  @@index([language, level], map: "idx_word_bank_lang_level")
}

model story_bank {
  id               BigInt   @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  level            Int      @default(1)
  tantra           String?  @db.VarChar(100)
  language         String   @default("en") @db.VarChar(10)
  title            String
  moral            String?
  characters       String?
  beat1_hook       String?
  beat2_setting    String?
  beat3_plot_entry String?
  beat4_first_half String?
  beat5_second_half String?
  beat6_ending     String?
  choice_question  String?
  choice_option_a  String?
  choice_option_b  String?
  sounds           String?
  kahavat          String?
  personalize      String?
  safety_notes     String?
  beats_total      Int      @default(6)
  active           Boolean  @default(true)
  create_date      DateTime @default(now()) @db.Timestamptz(6)
  update_date      DateTime @default(now()) @db.Timestamptz(6)

  @@index([language, level], map: "idx_story_bank_lang_level")
}

model spell_bank {
  id               BigInt   @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  level            Int      @default(1)
  language         String   @default("en") @db.VarChar(10)
  word             String
  phonics_chunks   String?
  meaning_simple   String?
  example_sentence String?
  active           Boolean  @default(true)
  create_date      DateTime @default(now()) @db.Timestamptz(6)
  update_date      DateTime @default(now()) @db.Timestamptz(6)

  @@index([language, level], map: "idx_spell_bank_lang_level")
}

/// What content a child has already been given, per bank — the durable
/// no-repeat ledger for the unscored characters. The MEMO's jokes_told= and
/// friends still exist for the model to read in-session, but they are a working
/// note, not the record: this table is what the serve endpoint excludes on.
model kid_content_seen {
  id         BigInt   @id @default(autoincrement())
  kid_id     BigInt?
  device_mac String   @db.VarChar(20)
  bank       String   @db.VarChar(20)
  code       String   @db.VarChar(50)
  seen_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([kid_id, bank], map: "idx_kid_content_seen_kid_bank")
  @@index([device_mac, bank], map: "idx_kid_content_seen_mac_bank")
  @@index([seen_at], map: "idx_kid_content_seen_at")
}

/// Current per-character state for a child, upserted from the session's final
/// MEMO line. Restored into the worker's Saved State each session AFTER the 48h
/// prune, so durable progress (Tikku's ladder, Tara's cliffhanger, Nani's
/// unfinished story) survives any gap. kid_id NULL rows carry device_mac
/// attribution for Unlinked devices (partial unique indexes in the migration).
model kid_character_state {
  id         BigInt   @id @default(autoincrement())
  kid_id     BigInt?
  device_mac String   @db.VarChar(20)
  state_type String   @db.VarChar(50)
  character  String?  @db.VarChar(100)
  memo       String
  data       Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// Append-only per-session progress log for every character — the parent-app /
/// analytics feed (parent_summary, jokes told, words practised, ...). One row
/// per (session, memo type).
model kid_session_progress {
  id           BigInt   @id @default(autoincrement())
  kid_id       BigInt?
  device_mac   String   @db.VarChar(20)
  character    String?  @db.VarChar(100)
  state_type   String   @db.VarChar(50)
  session_date DateTime @default(now()) @db.Date
  memo         String
  data         Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([kid_id, created_at], map: "idx_kid_session_progress_kid_time")
  @@index([device_mac, created_at], map: "idx_kid_session_progress_mac_time")
  @@index([state_type, session_date], map: "idx_kid_session_progress_type_date")
}

/// The Wonder Question (M4): one open, unscored question Quizzy leaves a child
/// with at the end of a session, and opens the next one by remembering.
///
/// A table rather than memory/state/ because that directory is pruned after 48
/// hours — a child who plays Friday and returns Monday would find it forgotten.
///
/// Deliberately NOT surfaced to the parent app: it records a child's private
/// curiosity, and knowing it is reported changes what a child will wonder aloud.
model kid_wonder_question {
  id         BigInt   @id @default(autoincrement())
  device_mac String   @db.VarChar(20)
  kid_id     BigInt?
  question   String
  asked_at   DateTime @default(now()) @db.Timestamptz(6)
  /// Stamped when the question is served back to the child. Null means "still
  /// owed": the serving read takes the newest null one, so a question is
  /// recalled once and then retires. Without it the newest row was recalled at
  /// the start of every session until a different one happened to be stored.
  recalled_at DateTime? @db.Timestamptz(6)
  /// What the child said, when they answered before the session ended. Null
  /// means the question was left open. Decides which recall the next session
  /// gets: a callback to their own idea, or the question asked again.
  answer_text String?

  @@index([kid_id, asked_at(sort: Desc)], map: "idx_kid_wonder_kid_time")
  @@index([device_mac, asked_at(sort: Desc)], map: "idx_kid_wonder_device_time")
}

/// Every try, including the wrong ones that never become an answer row. The
/// answer log records that a question was missed; this records how it was
/// missed — how many tries, and what the child actually said.
///
/// Deliberately NON-AUTHORITATIVE (ADR-0009). Its write may fail without
/// failing the child's turn, so nothing that gates progression may read it:
/// Cleared, days-on-level and the streak all keep deriving from
/// quiz_question_answer. A gate reading this table would silently stop firing
/// whenever the write failed.
///
/// One table for both banks rather than the parallel pair the answer logs use,
/// so `bank` carries the discriminator and there is no FK. That is affordable
/// precisely because these rows are diagnostic: an orphaned attempt row is a
/// lost measurement, not a child's lost progress.
model question_attempt {
  id          BigInt   @id @default(autoincrement())
  device_mac  String   @db.VarChar(20)
  kid_id      BigInt?
  bank        String   @db.VarChar(10)
  question_id BigInt
  attempt_no  Int
  verdict     String   @db.VarChar(10)
  /// What speech recognition heard. Null when the worker had no transcript.
  /// Retention is not yet aligned with ADR-0006's raw-transcript expiry — see
  /// docs/issues/quizzy-redesign/004-attempt-log.md.
  transcript  String?
  answered_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([bank, question_id, device_mac], map: "idx_question_attempt_bank_question_device")
  @@index([kid_id, answered_at], map: "idx_question_attempt_kid_time")
}

/// One AI-Imagine picture. The image itself stays in S3 under the key it was
/// first written with; this row is what says whose it is, so a child changing
/// toys is an UPDATE rather than a bucket copy. Before this table the gallery
/// was a raw prefix listing, silently capped at 1000 objects.
model imagine_image {
  id          BigInt   @id @default(autoincrement())
  owner_key   String
  mac_address String   @db.VarChar(20)
  s3_key      String   @unique(map: "uq_imagine_image_s3_key")
  size_bytes  BigInt?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_key, created_at(sort: Desc)], map: "idx_imagine_image_owner_created")
}

/// Which Child was paired to a Device, and when. Nothing reads this yet: it
/// exists so a Device that changes hands can have its MAC-keyed history split
/// between the two Children later, which is unreconstructable without it.
/// Keyed on the MAC rather than the device row because the historical rows it
/// will one day explain are keyed that way too.
model device_kid_assignment {
  id          BigInt    @id @default(autoincrement())
  mac_address String    @db.VarChar(20)
  kid_id      BigInt
  assigned_at DateTime  @default(now()) @db.Timestamptz(6)
  ended_at    DateTime? @db.Timestamptz(6)

  @@index([mac_address, assigned_at(sort: Desc)], map: "idx_device_kid_assignment_mac")
  @@index([kid_id, assigned_at(sort: Desc)], map: "idx_device_kid_assignment_kid")
}
