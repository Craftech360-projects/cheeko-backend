/// Curated quiz Question Bank. Quizzy never invents scored questions; it selects
/// from here. A Level is the set of ten questions sharing (language, level) —
/// one shared ladder for every age since ADR-0009, with the range carried by the
/// Doors rather than by separate content per age.
model quiz_question {
  id                   BigInt                 @id @default(autoincrement())
  code                 String                 @unique @db.VarChar(50)
  question_text        String
  answer_text          String
  accepted_answers     Json                   @default("[]")
  /// The one-breath explanation offered when the child could not get there
  /// alone. Authored, never improvised: a generated explanation aimed at a
  /// 4-year-old is exactly the hallucination risk ADR-0005 removed from asks.
  teach_text           String?
  /// Authored wrong answers for the narrowing hint. Authored rather than
  /// generated for the same reason, and a locked design decision.
  distractors          Json                   @default("[]")
  category             String?                @db.VarChar(100)
  level                Int
  language             String                 @default("en") @db.VarChar(10)
  active               Boolean                @default(true)
  create_date          DateTime               @default(now()) @db.Timestamptz(6)
  update_date          DateTime               @default(now()) @db.Timestamptz(6)
  quiz_question_answer quiz_question_answer[]

  @@index([language, level], map: "idx_quiz_question_lang_level")
}

/// Per-device answer log. This is the ONLY quiz progress state: Cleared and
/// current Level are derived from these rows, never stored.
model quiz_question_answer {
  id            BigInt        @id @default(autoincrement())
  device_mac    String        @db.VarChar(20)
  kid_id        BigInt?
  question_id   BigInt
  result        String        @db.VarChar(10)
  answered_at   DateTime      @default(now()) @db.Timestamptz(6)
  quiz_question quiz_question @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@index([device_mac, question_id], map: "idx_quiz_answer_device_question")
  @@index([device_mac, answered_at], map: "idx_quiz_answer_device_time")
  @@index([kid_id, answered_at], map: "idx_quiz_answer_kid_time")
}

/// Riddler's bank. Deliberately column-identical to quiz_question — including
/// question_text rather than the better-reading riddle_text — so one service can
/// query either bank with no per-bank field mapping. See src/services/banks.js.
model riddle_question {
  id                     BigInt                   @id @default(autoincrement())
  code                   String                   @unique @db.VarChar(50)
  question_text          String
  answer_text            String
  accepted_answers       Json                     @default("[]")
  /// Present to keep this table column-identical to quiz_question, which is what
  /// lets one service query either bank. Riddler keeps flow rather than mastery
  /// (ADR-0009), so it has no Door 3 to teach at and these stay null today.
  teach_text             String?
  distractors            Json                     @default("[]")
  category               String?                  @db.VarChar(100)
  level                  Int
  language               String                   @default("en") @db.VarChar(10)
  active                 Boolean                  @default(true)
  create_date            DateTime                 @default(now()) @db.Timestamptz(6)
  update_date            DateTime                 @default(now()) @db.Timestamptz(6)
  riddle_question_answer riddle_question_answer[]

  @@index([language, level], map: "idx_riddle_question_lang_level")
}

/// Per-device riddle answer log. Separate from quiz_question_answer so a riddle
/// can never clear a quiz level: the isolation is the table, not a filter
/// someone can forget.
model riddle_question_answer {
  id              BigInt          @id @default(autoincrement())
  device_mac      String          @db.VarChar(20)
  kid_id          BigInt?
  question_id     BigInt
  result          String          @db.VarChar(10)
  answered_at     DateTime        @default(now()) @db.Timestamptz(6)
  riddle_question riddle_question @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@index([device_mac, question_id], map: "idx_riddle_answer_device_question")
  @@index([device_mac, answered_at], map: "idx_riddle_answer_device_time")
  @@index([kid_id, answered_at], map: "idx_riddle_answer_kid_time")
}

/// Ginti's bank. Column-identical to quiz_question — same deliberate choice as
