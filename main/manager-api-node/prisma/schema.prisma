/// Allowlist of issued custom-card UIDs. Membership is what makes a UID a custom
/// card; the content itself lives in rfid_content_pack CUSTOM_KID_<kidId>, keyed
/// on the child paired to the tapping toy. kid_id is legacy — new rows leave it
/// null: binding a physical UID to a child would mean a card only works for one
/// kid, the opposite of the "any blank card, any toy" model the cards ship under.
model custom_card {
  id          BigInt       @id @default(autoincrement())
  kid_id      BigInt?      @unique
  rfid_uid    String?      @unique @db.VarChar(50)
  creator     BigInt?
  create_date DateTime     @default(now()) @db.Timestamptz(6)
  updater     BigInt?
  update_date DateTime     @default(now()) @db.Timestamptz(6)
  kid_profile kid_profile? @relation(fields: [kid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kid_id], map: "idx_custom_card_kid")
  @@index([rfid_uid], map: "idx_custom_card_rfid")
}

